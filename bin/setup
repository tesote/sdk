#!/usr/bin/env bash
# one-command setup — established by the developerz.ai maintainer agent for the maintainers of this repository. One command; adjust as the repo grows.
set -euo pipefail
cd "$(dirname "$0")/.."
command -v mise >/dev/null && mise install
(cd 'go' && go mod download) && (cd 'packages/python' && python -m venv .venv && ./.venv/bin/pip install -e .) && (cd 'packages/ruby' && bundle install) && (cd 'packages/ts' && npm ci)
